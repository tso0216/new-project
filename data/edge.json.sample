// edge.json：每個元素是一條「景點 A → 景點 B」的實際移動。
// 這份檔案給 LLM 當輸出規格：LLM 讀「一篇」旅遊資料，同時輸出 node（見 node.json.sample）與 edge。
// 本檔含註解僅供參考，實際輸出必須是不含註解的合法 JSON。
// 上半是範例，下半是每個欄位的型別與規則。
// 全域原則：只根據這篇文章；原文沒寫的一律填 null 或 []，不要猜、不要用自己的知識補。
[
  {
    "edge_id": "E0001",
    "from": "P001",
    "to": "P002",
    "mode": "自駕",
    "mode_inferred": true,
    "mode_basis": "旅行社跟團預設遊覽車",
    "vehicle": null,
    "duration_min": 20,
    "via": ["免稅店"],
    "months": [9, 10, 11],
    "trip_id": "colatour_237034",
    "day": 2,
    "seq": 1,
    "source_type": "旅行社",
    "url": "https://tour.colatour.com.tw/itinerary?PatternNo=237034"
  }
]


// ───────────────────────── 欄位定義（LLM 依文章填寫）─────────────────────────
// 每個欄位：型別、規則、例子。
//
// edge_id        string
//   規則："E" + 4 位數，依輸出順序從 "E0001" 開始連號。
//   例："E0001"
//
// from           string
//   規則：起點景點的 poi_id，必須是你在 node 陣列裡定義過的 poi_id。
//   例："P001"
//
// to             string
//   規則：終點景點的 poi_id，必須是你在 node 陣列裡定義過的 poi_id；不可與 from 相同。
//   例："P002"
//
// mode           "大眾運輸" | "自駕" | "走路" | null
//   規則：依 mode_basis 的順序判斷。大眾運輸＝火車、地鐵、電車、公車、船班；
//         自駕＝旅行社遊覽車、租車；走路＝步行。判斷不出來就 null。
//   例："大眾運輸"
//
// mode_inferred  boolean
//   規則：原文明寫交通方式 → false；靠 mode_basis 的推斷規則得到 → true；mode 為 null → false。
//   例：原文「搭銀座線到淺草」→ false；旅行社跟團行程沒寫交通 → true
//
// mode_basis     "原文明寫" | "旅行社跟團預設遊覽車" | "同園區步行範圍" | "途經車站" | "遊記起訖點記成車站" | "原文未寫"
//   規則：依序套用，命中第一條就停：
//     1. 原文明寫交通方式 → "原文明寫"
//     2. 兩景點在同一園區／同一步行範圍（如淺草寺→仲見世通）→ mode 填 "走路"，"同園區步行範圍"
//     3. 旅行社「跟團」行程（非自由行）且原文沒寫 → mode 填 "自駕"，"旅行社跟團預設遊覽車"
//     4. via 裡有車站 → mode 填 "大眾運輸"，"途經車站"
//     5. 遊記中起點或終點被寫成車站名（如「到鎌倉站後去鶴岡八幡宮」）→ mode 填 "大眾運輸"，"遊記起訖點記成車站"
//     6. 以上皆否 → mode 填 null，"原文未寫"
//   例："原文明寫"
//
// vehicle        string | null
//   規則：原文寫的具體交通工具（線名、車種、船名），逐字照抄；只寫「搭車」「搭電車」這類泛稱時照抄該詞；
//         完全沒寫就 null。
//   例："銀座線"、"江之島電鐵"、"JR山手線"、"遊覽車"
//
// duration_min   integer | null
//   規則：原文明寫的「移動」時間，換成分鐘整數。「約1小時」→ 60；「30~40分」→ 取中間值 35。
//         只算移動時間，不算停留、用餐、排隊。沒寫就 null，不要自己估。
//   例：20
//
// via            string[]
//   規則：這兩個景點之間被略過的「非景點」（車站、機場、飯店、免稅店、一般餐廳、休息站），
//         原文逐字名稱，依經過順序。沒有就 []。景點本身不放進 via。
//   例：["免稅店"]、["鎌倉站", "江之島站"]、[]
//
// months         integer[]
//   規則：1–12 的整數，由小到大、不重複。旅行社行程＝出團月份（front matter 的 departure_months，
//         "2026/09" → 9）；遊記＝文中寫的實際旅行月份。原文沒寫就 []。同一篇文章所有邊相同。
//   例：[9, 10, 11]
//
// trip_id        string
//   規則：來源名 + "_" + 行程代號。行程代號取自 url：可樂取 PatternNo= 後的值、雄獅取網址中的 UUID、
//         燦星取團號、遊記取網址最後一段路徑（文章 ID）。
//   例："colatour_237034"
//
// day            integer
//   規則：這段移動發生在第幾天（D1 → 1）。遊記沒分天就全部填 1。不跨天建邊。
//   例：2
//
// seq            integer
//   規則：這段移動是當天的第幾段，每天從 1 重新起算、連號。
//         trip_id + day + seq 可以把邊串回原本那一天的路線。
//   例：1
//
// source_type    "旅行社" | "遊記"
//   規則：來源是旅行社（colatour、liontravel、travel4u 等）→ "旅行社"；
//         部落格、論壇（pixnet、ptt、dcard 等）→ "遊記"。
//   例："旅行社"
//
// url            string
//   規則：文章 front matter 的 url，原樣照抄。
//   例："https://tour.colatour.com.tw/itinerary?PatternNo=237034"
