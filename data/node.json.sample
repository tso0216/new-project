// node.json：每個元素是一個景點（POI）。
// 這份檔案給 LLM 當輸出規格：LLM 讀「一篇」旅遊資料，同時輸出 node 與 edge（見 edge.json.sample）。
// 本檔含註解僅供參考，實際輸出必須是不含註解的合法 JSON。
// 上半是範例，下半是每個欄位的型別與規則。
// 全域原則：只根據這篇文章；原文沒寫的一律填 null 或 []，不要猜、不要用自己的知識補。
// 什麼算景點：神社寺廟、公園庭園、自然景觀、商圈老街、購物區、遊船纜車、地標展望、博物館、主題樂園、
//   歷史古蹟、市場、動物園、溫泉街、目的地型餐飲。
// 不算景點（不建 node，只能放進 edge 的 via）：機場、車站（除非車站本身被當觀光點介紹）、
//   飯店／住宿、免稅店、一般用餐餐廳、休息站、集合地點。

[
  {
    "poi_id": "P001",
    "poi_name": "淺草寺",
    "lat": 35.7148,
    "lon": 139.7967,
    "duration": 60,
    "months": [9, 10, 11],
    "source_count": 3,
    "url": ["https://tour.colatour.com.tw/itinerary?PatternNo=237034"],
    "observations": [
      {
        "trip_id": "colatour_237034",
        "months": [9, 10, 11],
        "name_raw": "淺草寺（雷門）",
        "visit_type": "入內參觀",
        "stay_min": 60,
        "as_area": false
      }
    ]
  }
]


// ───────────────────────── 欄位定義（LLM 依文章填寫）─────────────────────────
// 每個欄位：型別、規則、例子。同一個景點在這篇文章裡只建一個 node。
//
// poi_id         string
//   規則：這篇輸出內的編號，"P" + 3 位數，依景點在文章中第一次出現的順序從 "P001" 連號。
//         edge 的 from／to 用它指向這個 node。
//   例："P001"
//
// poi_name       string
//   規則：景點的標準名稱：繁體中文、常見正式名稱，去掉括號附註和「參觀」「巡禮」「散策」等動作詞。
//         原文只有日文或英文時，用通行的中文名。
//   例："淺草寺"、"東京迪士尼海洋"（原文「海洋迪士尼樂園」）
//
// lat            number | null
//   規則：只有原文明確給出座標才填（十進位小數）；沒有就 null，不要用自己的知識補。
//   例：35.7148
//
// lon            number | null
//   規則：同 lat。
//   例：139.7967
//
// duration       integer | null
//   規則：這個景點 observations 中所有非 null 的 stay_min 的中位數，四捨五入成整數（分）；
//         全部都是 null 就 null。
//   例：60
//
// months         integer[]
//   規則：這個景點所有 observations 的 months 的聯集，1–12、由小到大、不重複。都沒有就 []。
//   例：[9, 10, 11]
//
// source_count   integer
//   規則：出現這個景點的行程／遊記數。你一次只讀一篇，所以固定填 1。
//   例：1
//
// url            string[]
//   規則：只放這篇文章 front matter 的 url，原樣照抄。
//   例：["https://tour.colatour.com.tw/itinerary?PatternNo=237034"]
//
// observations   object[]
//   規則：這個景點在文章中每出現一次就記一筆（同一景點在文章中多次出現就多筆）。欄位如下：
//
//   trip_id      string
//     規則：格式同 edge 的 trip_id：來源名 + "_" + 行程代號。
//     例："colatour_237034"
//
//   months       integer[]
//     規則：旅行社行程＝出團月份；遊記＝實際旅行月份；原文沒寫就 []。
//     例：[9, 10, 11]
//
//   name_raw     string
//     規則：原文中這個景點的逐字寫法，照抄，不改字、不轉簡繁、不去括號。
//     例："淺草寺（雷門）"
//
//   visit_type   "入內參觀" | "下車拍照" | "行車經過" | null
//     規則：原文標明要進去參觀 → "入內參觀"；只下車拍照、短暫停留 → "下車拍照"；
//           只是車子經過、不停留 → "行車經過"；原文沒標明就 null。
//     例："入內參觀"
//
//   stay_min     integer | null
//     規則：原文明寫作者在這個景點停留的分鐘數，換成整數；「約1小時」→ 60。沒寫就 null，不要自己估。
//     例：60
//
//   as_area      boolean
//     規則：原文寫的是車站或商店（不是景點本身），但作者在那裡停留很久、實際是在逛那一區，
//           所以你把它歸到對應的區域景點（poi_name 填該區域）→ true；
//           原文寫的就是景點本身 → false。車站本身是景點時（例如鎌倉高校前站的平交道）也填 false。
//     例：原文「吉祥寺站」停留 210 分、作者寫在逛吉祥寺一帶，poi_name 填「吉祥寺」→ true；原文「淺草寺」→ false
